body {
  font-family: "Fira Sans";
  font-weight: normal;
  font-style: normal;
  width: 100vw;
  height: 100vh;
  margin: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* --- Panel Layouts --- */
.menu_panel {
  display: flex;
  flex-direction: column;
  width: 250dp;
  padding: 50dp;
  background-color: #111418cc;
  border-radius: 16dp;
}

.game_panel {
  display: flex;
  width: 200dp;
  padding: 50dp;
}

/* --- Visibility & Positioning Toggles --- */
#main_menu {
  display: flex;
}
#online_menu,
#online_lobby,
#lobby {
  display: none;
}

#game_ui {
  display: none;
  flex-direction: column;
}

/* CENTERED HUD STATE OVERLAY */
#game_end_ui {
  display: none;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* --- Typography --- */
h1 {
  font-size: 24dp;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  margin-top: 0;
  margin-bottom: 40dp;
  font-effect: shadow(0dp 4dp #00000080);
}

.player-card {
  background-color: #1e252d;
  border: 2dp #2a323d;
  border-radius: 8dp;
  padding: 20dp;
  margin-bottom: 16dp;
  text-align: center;
}

.player-card h2 {
  font-size: 24dp;
  margin: 0;
  margin-bottom: 10dp;
  color: #fb8d45;
}

.status-text {
  font-size: 24dp;
  text-align: center;
}
.ready {
  color: #00ff00;
}
.not-ready {
  color: #ff0000;
}

.player-info {
  color: #fb8d45;
  background-color: #1e252d;
  border: 0dp #2a323d;
  border-radius: 8dp;

  text-align: left;
  font-size: 20dp;

  padding: 10dp;
  margin-bottom: 16dp;

  position: absolute;
  top: 20dp;
}

#p1_info {
  left: 20dp;
  text-align: left;
}

#p2_info {
  right: 20dp;
  text-align: right;
}

.game-state-info {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  background-color: #1e252d;
  border: 0dp #2a323d;
  border-radius: 8dp;
  padding: 10dp;
  margin-bottom: 16dp;
}

.game-state-info h1 {
  text-align: center;
  margin: 10dp 0;
}

/* --- Form Fields --- */
.field-row {
  display: flex;
  align-items: center;
  margin-bottom: 16dp;
}

.field-label {
  width: 60dp;
  font-size: 20dp;
  color: #7f8c8d;
}

input.text {
  box-sizing: border-box;
  flex: 1;
  padding: 10dp;

  font-size: 20dp;
  color: #e2e8f0;

  background-color: #1e252d;
  border: 2dp #2a323d;
  border-radius: 8dp;
}

input.text:focus {
  border-color: #fb8d45;
}

/* --- Buttons --- */
button.action {
  display: block;
  box-sizing: border-box;
  width: 100%;
  padding: 16dp;
  margin-bottom: 16dp;

  text-align: center;
  font-size: 20dp;
  color: #e2e8f0;

  background-color: #fb8d45;
  border: 2dp #00000080;
  border-radius: 8dp;

  decorator: vertical-gradient(#ae622f #fb8d45);
  transform-origin: center center;

  transition:
    transform 0.1s,
    border-color 0.1s,
    color 0.1s;
}

button.action:last-child {
  margin-bottom: 0;
}

button.action:hover {
  border: 2dp #2a323d;
  border-color: #00000080;
  color: #ffffff;
  transform: scale(1.02);
  decorator: vertical-gradient(#fb8d45 #fb8d45);
}

button.action:active {
  transform: scale(0.98);
  color: #ae622f;
  decorator: vertical-gradient(#ae622f #ae622f);
}
