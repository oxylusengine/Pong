body {
  font-family: "Fira Sans";
  font-weight: normal;
  font-style: normal;
  width: 100vw;
  height: 100vh;
  margin: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.menu_panel {
  display: flex;
  flex-direction: column;
  width: 400dp;
  padding: 50dp;
  background-color: #111418cc;
  border-radius: 16dp;
}

.game_panel {
  display: flex;
  width: 200dp;
  padding: 50dp;
}

#main_menu {
  display: flex;
}
#online_menu {
  display: none;
}
#lobby {
  display: none;
}
#game_ui {
  display: none;
}

h1 {
  font-size: 24dp;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
  margin-top: 0;
  margin-bottom: 40dp;
  font-effect: shadow(0dp 4dp #00000080);
}

.player-card {
  background-color: #1e252d;
  border: 2dp #2a323d;
  border-radius: 8dp;
  padding: 20dp;
  margin-bottom: 16dp;
  text-align: center;
}

.player-card h2 {
  font-size: 24dp;
  margin: 0;
  margin-bottom: 10dp;
  color: #fb8d45;
}

.status_text {
  font-size: 24dp;
}
.ready {
  color: #00ff00;
}
.not-ready {
  color: #ff0000;
}

.player-info {
  background-color: #1e252d;
  border: 2dp #2a323d;
  border-radius: 8dp;
  padding: 20dp;
  margin-bottom: 16dp;
  text-align: left;
}

.player-info h2 {
  font-size: 24dp;
  margin: 0;
  margin-bottom: 10dp;
  color: #fb8d45;
}

input.text:focus {
  border-color: #fb8d45;
}

button.action {
  display: block;
  box-sizing: border-box;
  width: 100%;
  padding: 16dp;
  margin-bottom: 16dp;

  text-align: center;
  font-size: 24dp;
  color: #e2e8f0;

  background-color: #fb8d45;
  border: 2dp #00000080;
  border-radius: 8dp;

  decorator: vertical-gradient(#ae622f #fb8d45);

  transition:
    transform 0.1s,
    border-color 0.1s,
    color 0.1s;

  transform-origin: center center;
}

button.action:last-child {
  margin-bottom: 0;
}

button.action:hover {
  border: 2dp #2a323d;
  border-color: #00000080;
  color: #ffffff;
  transform: scale(1.02);

  decorator: vertical-gradient(#fb8d45 #fb8d45);
}

button.action:active {
  transform: scale(0.98);
  color: #ae622f;

  decorator: vertical-gradient(#ae622f #ae622f);
}
